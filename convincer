-- ========== AUTO-TRANSLATE ==========
local transState={}
local function getState(sf) local s=transState[sf]; if not s then s={n=0,votes={}}; transState[sf]=s end return s end
local function isMsgF(o) return o:IsA("Frame") and o.Name:find("^Message")~=nil end
local function collect(sf)
    local arr={}; for _,ch in ipairs(sf:GetChildren()) do if isMsgF(ch) then arr[#arr+1]=ch end end
    table.sort(arr,function(a,b) return (a.LayoutOrder or 0)<(b.LayoutOrder or 0) end)
    local out={}
    for _,f in ipairs(arr) do
        local lbl=f:FindFirstChild("Label",true); local txt=lbl and lbl.Text
        if type(txt)=="string" and #txt>=2 and txt~="Template" then
            local theirs=true
            local pi=f:FindFirstChild("PlayerImage"); pi=pi and pi:FindFirstChild("Headshot")
            if pi and type(pi.Image)=="string" then local m=pi.Image:match("id=(%d+)"); if m and tonumber(m)==LP.UserId then theirs=false end end
            out[#out+1]={text=txt,theirs=theirs}
        end
    end
    return out
end
local function translateAndLog(sf,text)
    local s=getState(sf)
    task.spawn(function()
        local tr,det=googleTranslate(text,Settings.myLang,"auto")
        local wc=0; for _ in tostring(text):gmatch("%S+") do wc=wc+1 end
        if det and det~="auto" and det~="" then
            s.votes[det]=(s.votes[det] or 0)+math.clamp(wc,1,8)
            local best,bn=nil,0
            for k,v in pairs(s.votes) do if k~="en" and v>bn then best,bn=k,v end end
            if not best then for k,v in pairs(s.votes) do if v>bn then best,bn=k,v end end end
            if best and Settings.theirLang~=best then Settings.theirLang=best; theirVal.Text=langName(best); saveCfg() end
        end
        pushLog(text,(tr and tr~=text) and tr or text)
    end)
end
local function attachReader(sf)
    local s=getState(sf)
    local function step()
        local list=collect(sf)
        if #list<s.n then s.n=0; s.votes={}; Settings.theirLang="auto"; theirVal.Text=langName("auto") end
        for i=s.n+1,#list do
            local m=list[i]
            if m.theirs and Settings.translatorOn and alive() then translateAndLog(sf,m.text) end
        end
        s.n=#list
    end
    step()
    sf.ChildAdded:Connect(function() task.defer(step) end)
    sf.ChildRemoved:Connect(function() task.defer(step) end)
end
local function attachChatContainer(chat)
    local attached={}
    for _,name in ipairs({"NormalChat","RestrictedChat"}) do
        local c=chat:FindFirstChild(name)
        if c then
            local sf=c:FindFirstChild("ScrollingFrame")
            if sf and not attached[sf] then attached[sf]=true; attachReader(sf) end
            if not sf then c.ChildAdded:Connect(function(ch) if ch.Name=="ScrollingFrame" and not attached[ch] then attached[ch]=true; attachReader(ch) end end) end
        end
    end
end
local function attachTradeUI(tlu)
    task.spawn(function()
        local t2=tlu:WaitForChild("TradeLiveTrade",5) or tlu
        local chat=t2:FindFirstChild("Chat")
        if chat then attachChatContainer(chat); return end
        t2.ChildAdded:Connect(function(c) if c.Name=="Chat" then attachChatContainer(c) end end)
    end)
end
