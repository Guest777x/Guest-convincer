local function syncFriend(btn,txt,other)
    if not btn or not btn.Parent then return end
    local ok,st=pcall(function() return LP:GetFriendStatus(other) end); if not ok then return end
    pcall(function()
        if st==Enum.FriendStatus.Friend then btn.Visible=false
        elseif st==Enum.FriendStatus.FriendRequestSent then txt.Text="SENT"; btn.BackgroundColor3=Color3.fromRGB(120,120,120); btn.Visible=true
        elseif st==Enum.FriendStatus.FriendRequestReceived then txt.Text="ACCEPT"; btn.BackgroundColor3=THEME.FRIEND; btn.Visible=true
        else txt.Text="FRIEND"; btn.BackgroundColor3=THEME.FRIEND; btn.Visible=true end
    end)
end
