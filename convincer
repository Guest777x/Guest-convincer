local LIST_LAST = ""

local function renderTraders()
    local all = scanTraders()
    local q = searchQuery:lower():gsub("^%s+",""):gsub("%s+$","")
    local filtered = all
    if q ~= "" then
        filtered = {}
        for _, p in ipairs(all) do
            local hit = p.player:lower():find(q,1,true) ~= nil
            if not hit then
                for _, it in ipairs(p.items) do
                    if it.index:lower():find(q,1,true)
                        or (it.mutation and it.mutation:lower():find(q,1,true))
                        or it.rarity:lower():find(q,1,true) then
                        hit = true; break
                    end
                end
            end
            if hit then filtered[#filtered+1] = p end
        end
    end

    local sig = q .. "~"
    for _, p in ipairs(filtered) do sig = sig .. p.player .. #p.items .. math.floor(p.totalGen) .. "|" end
    if sig == LIST_LAST then return end
    LIST_LAST = sig

    for _, ch in ipairs(listScroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end

    if #filtered == 0 then
        local f = Instance.new("Frame", listScroll)
        f.Size = UDim2.new(1,0,0,80); f.BackgroundTransparency = 1
        local t = Instance.new("TextLabel", f)
        t.Size = UDim2.fromScale(1,1); t.BackgroundTransparency = 1
        t.Font = Enum.Font.GothamMedium; t.TextSize = 12; t.TextColor3 = THEME.OFF_TEXT
        t.TextWrapped = true
        t.Text = q ~= "" and ('no matches for "' .. q .. '"')
            or "no Secret/OG traders found.\nif this stays empty, your executor cannot read game data."
        return
    end

    for i, p in ipairs(filtered) do
        local card = Instance.new("Frame", listScroll)
        card.Size = UDim2.new(1,0,0,54); card.BackgroundTransparency = 1
        card.LayoutOrder = i; card.ClipsDescendants = true; card.Name = "P_"..i

        local inner = Instance.new("Frame", card)
        inner.Size = UDim2.new(1,-4,0,52); inner.Position = UDim2.fromOffset(2,1)
        inner.BackgroundColor3 = THEME.SURF; inner.BorderSizePixel = 0
        corner(inner, 10); local istr = stroke(inner, THEME.STROKE, 1, 0.6)

        local rank = Instance.new("TextLabel", inner)
        rank.Size = UDim2.fromOffset(20,54); rank.Position = UDim2.fromOffset(2,0)
        rank.BackgroundTransparency = 1; rank.Font = Enum.Font.GothamBlack
        rank.Text = "#"..i; rank.TextSize = 10; rank.TextColor3 = THEME.ACCENT

        local offsetX = 24
        if Settings.showAvatars then
            local av = Instance.new("ImageLabel", inner)
            av.Size = UDim2.fromOffset(34,34); av.Position = UDim2.fromOffset(24,9)
            av.BackgroundColor3 = THEME.SURF2; av.BorderSizePixel = 0
            corner(av, 17); av.ZIndex = 3
            task.spawn(function()
                local uid = p.playerObj and p.playerObj.UserId
                if not uid then pcall(function() uid = Players:GetUserIdFromNameAsync(p.player) end) end
                if uid then
                    local ok, img = pcall(function() return Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48) end)
                    if ok and img and av.Parent then av.Image = img end
                end
            end)
            offsetX = 66
        end

        local nameL = Instance.new("TextLabel", inner)
        nameL.Size = UDim2.new(1,-(offsetX+118),0,18); nameL.Position = UDim2.fromOffset(offsetX,8)
        nameL.BackgroundTransparency = 1; nameL.Font = Enum.Font.GothamBold
        nameL.Text = p.player; nameL.TextSize = 13; nameL.TextColor3 = THEME.TEXT
        nameL.TextXAlignment = Enum.TextXAlignment.Left
        nameL.TextTruncate = Enum.TextTruncate.AtEnd

        local sub = Instance.new("TextLabel", inner)
        sub.Size = UDim2.new(1,-(offsetX+118),0,14); sub.Position = UDim2.fromOffset(offsetX,28)
        sub.BackgroundTransparency = 1; sub.Font = Enum.Font.GothamBold
        sub.Text = #p.items.." • total $"..fmt(p.totalGen).."/s"
        sub.TextSize = 10; sub.TextColor3 = THEME.GREEN_STROKE
        sub.TextXAlignment = Enum.TextXAlignment.Left

        -- Manual trade button (2-step confirm). This is the ONLY outbound path.
        local tradeBtn = button(inner, "OPEN TRADE", { textSize = 10 })
        tradeBtn.Size = UDim2.fromOffset(94,34)
        tradeBtn.Position = UDim2.new(1,-100,0.5,-17)
        local armed = false
        local armTime = 0
        tradeBtn.MouseButton1Click:Connect(function()
            if Settings.requireConfirmManualTrade and not (armed and (os.clock() - armTime) < 4) then
                armed = true; armTime = os.clock()
                tradeBtn.Text = "CONFIRM 4s"
                tween(tradeBtn, 0.1, { BackgroundColor3 = THEME.DANGER })
                task.delay(4.2, function()
                    if tradeBtn.Parent and armed and (os.clock() - armTime) >= 4 then
                        armed = false
                        tradeBtn.Text = "OPEN TRADE"
                        tween(tradeBtn, 0.1, { BackgroundColor3 = THEME.ACCENT2 })
                    end
                end)
                return
            end
            armed = false
            tradeBtn.Text = "..."
            task.spawn(function()
                local ok, err = openTradeUIFor(p.player)
                tradeBtn.Text = ok and "OPENED" or "FAILED"
                Toast(ok and "TRADE OPENED" or "TRADE UNAVAILABLE", ok and ("prompt sent to "..p.player.." — confirm in-game UI yourself") or tostring(err), 3)
                task.delay(2, function()
                    if tradeBtn.Parent then
                        tradeBtn.Text = "OPEN TRADE"
                        tween(tradeBtn, 0.1, { BackgroundColor3 = THEME.ACCENT2 })
                    end
                end)
            end)
        end)

        local expandBtn = button(inner, "v", { color = THEME.SURF2, press = THEME.ACCENT2, stroke = THEME.STROKE, strokeT = 0.5, textSize = 13 })
        expandBtn.Size = UDim2.fromOffset(32,34)
        expandBtn.Position = UDim2.new(1,-36,0.5,-17)

        local detail = Instance.new("Frame", card)
        detail.Size = UDim2.new(1,0,0,0); detail.Position = UDim2.fromOffset(0,54)
        detail.BackgroundTransparency = 1; detail.BorderSizePixel = 0; detail.ClipsDescendants = true
        local dl = Instance.new("UIListLayout", detail)
        dl.Padding = UDim.new(0,6); dl.SortOrder = Enum.SortOrder.LayoutOrder
        local dp = Instance.new("UIPadding", detail)
        dp.PaddingTop = UDim.new(0,6); dp.PaddingLeft = UDim.new(0,16); dp.PaddingRight = UDim.new(0,2)

        for j, it in ipairs(p.items) do
            local row = Instance.new("Frame", detail)
            row.Size = UDim2.new(1,0,0,42); row.LayoutOrder = j
            row.BackgroundColor3 = THEME.SURF2; row.BorderSizePixel = 0
            corner(row, 8); stroke(row, THEME.STROKE, 1, 0.7)
            local nm = Instance.new("TextLabel", row)
            nm.Size = UDim2.new(1,-14,0,18); nm.Position = UDim2.fromOffset(10,4)
            nm.BackgroundTransparency = 1; nm.Font = Enum.Font.GothamBold; nm.RichText = true
            local mut = it.mutation
            if mut then
                local def = Data.Mutations[mut]
                local col = def and def.MainColor and tostring(def.MainColor) or nil
                local hex = "B0B0B0"
                if col then
                    local nums = {}
                    for m in col:gmatch("[%d%.]+") do nums[#nums+1] = tonumber(m) end
                    if #nums >= 3 then
                        hex = Color3.new(nums[1], nums[2], nums[3]):ToHex()
                    end
                end
                mut = ('  <font color="#%s">%s</font>'):format(hex, mut)
            end
            nm.Text = it.index .. (mut or "")
            nm.TextSize = 12; nm.TextColor3 = THEME.TEXT; nm.TextXAlignment = Enum.TextXAlignment.Left
            nm.TextTruncate = Enum.TextTruncate.AtEnd
            local sub2 = Instance.new("TextLabel", row)
            sub2.Size = UDim2.new(1,-14,0,14); sub2.Position = UDim2.fromOffset(10,22)
            sub2.BackgroundTransparency = 1; sub2.Font = Enum.Font.GothamBold
            sub2.Text = "$"..fmt(it.gen).."/s  •  "..it.rarity
            sub2.TextSize = 10; sub2.TextColor3 = THEME.GREEN_STROKE
            sub2.TextXAlignment = Enum.TextXAlignment.Left
        end

        local expanded = false
        local totalH = #p.items * 48 + 6 + 32
        local function setExpand(on, instant)
            expanded = on
            expandBtn.Text = on and "^" or "v"
            local h = on and totalH or 0
            if instant then
                detail.Size = UDim2.new(1,0,0,h); card.Size = UDim2.new(1,0,0,54+h)
            else
                tween(detail, 0.22, { Size = UDim2.new(1,0,0,h) })
                tween(card, 0.22, { Size = UDim2.new(1,0,0,54+h) })
            end
        end
        expandBtn.MouseButton1Click:Connect(function() setExpand(not expanded) end)

        inner.MouseEnter:Connect(function() tween(inner, 0.12, { BackgroundColor3 = THEME.SURF2 }) end)
        inner.MouseLeave:Connect(function() tween(inner, 0.12, { BackgroundColor3 = THEME.SURF }) end)
    end
end

