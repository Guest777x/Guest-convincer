local function decodeTranslationResponse(response)
    if type(response) ~= "table" then return nil end
    if response.Success == false or response.success == false then return nil end
    local status = response.StatusCode or response.status_code or response.Status or response.status
    if status ~= nil then
        status = tonumber(status)
        if not status or status < 200 or status >= 300 then return nil end
    end
    local body = response.Body or response.body
    if type(body) ~= "string" or body == "" then return nil end
    local ok, dec = pcall(function() return HttpService:JSONDecode(body) end)
    return ok and type(dec) == "table" and dec or nil
end

local function googleTranslate(text, targetLang, sourceLang)
    sourceLang = type(sourceLang) == "string" and sourceLang ~= "" and sourceLang or "auto"
    if type(text) ~= "string" or text == "" or type(targetLang) ~= "string" or targetLang == "" or type(HTTP) ~= "function" then
        return text, sourceLang
    end
    local ok, response = pcall(function()
        local url = ("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(
            HttpService:UrlEncode(sourceLang), HttpService:UrlEncode(targetLang), HttpService:UrlEncode(text))
        return HTTP({ Url = url, Method = "GET", Headers = { ["User-Agent"] = "Mozilla/5.0" } })
    end)
    if not ok then return text, sourceLang end
    local dec = decodeTranslationResponse(response)
    local first = dec and dec[1]
    if type(first) == "table" then
        if type(first[1]) == "string" and first[1] ~= "" then
            local detected = type(first[2]) == "string" and first[2] ~= "" and first[2] or sourceLang
            return first[1], detected
        end
    elseif type(first) == "string" and first ~= "" then
        return first, sourceLang
    end
    return text, sourceLang
end

