-- ============================================================
-- PRIORITY SCAN + AUTO HOP LOOP
-- ============================================================
local function findPriorityInServer()
    if not Settings.priorityList or #Settings.priorityList == 0 then return nil end
    local set = {}
    for _, v in ipairs(Settings.priorityList) do set[tostring(v):lower()] = true end
    local plots = workspace:FindFirstChild("Plots")
    if not plots or not Sync then return nil end
    for _, child in ipairs(plots:GetChildren()) do
        local ok, t = pcall(function() return Sync:GetTableFromChannel(child.Name) end)
        if ok and type(t) == "table" and type(t.AnimalList) == "table" then
            for _, item in ipairs(t.AnimalList) do
                if type(item) == "table" and item.Index and item.Index ~= "Empty" then
                    if set[tostring(item.Index):lower()] then
                        local owner = typeof(t.Owner) == "Instance" and t.Owner.Name or tostring(t.Owner)
                        return owner, item.Index
                    end
                end
            end
        end
    end
    return nil
end

task.spawn(function()
    task.wait(4)
    while sg.Parent and alive() do
        if Settings.autoHop and Settings.priorityList and #Settings.priorityList > 0 then
            local owner, index = findPriorityInServer()
            if index then
                Toast("PRIORITY FOUND", index .. (owner and (" @ " .. owner) or ""), 3)
                alertSound()
                Settings.autoHop = false; saveCfg()
                break
            else
                for k, t in pairs(Hops.hoppedServers) do
                    if os.time() - t > 600 then Hops.hoppedServers[k] = nil end
                end
                saveHops()
                Toast("HOPPING", "no priority here — searching...", 2)
                task.wait(Settings.hopDelay or 2)
                hopServer(Settings.hopTier)
                task.wait(6)
                task.wait(3)
            end
        else
            task.wait(3)
        end
    end
end)

