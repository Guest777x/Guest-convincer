local function fmt(n)
    n=tonumber(n) or 0
    if n>=1e12 then return string.format("%.1fT",n/1e12) end
    if n>=1e9 then return string.format("%.1fB",n/1e9) end
    if n>=1e6 then return string.format("%.1fM",n/1e6) end
    if n>=1e3 then return string.format("%.1fK",n/1e3) end
    return tostring(math.floor(n))
end
local function genOf(item)
    local def=Animals[item.Index]; if not def or not def.Generation then return 0 end
    local mult=1
    if item.Mutation and item.Mutation~="None" and item.Mutation~="" then
        local m=Mutations[item.Mutation]; if m and m.Modifier then mult=1+m.Modifier end
    end
    if type(item.Traits)=="table" then for _,t in ipairs(item.Traits) do local td=Traits[t]; if td and td.MultiplierModifier then mult=mult+td.MultiplierModifier end end end
    return (tonumber(def.Generation) or 0)*mult
end
local function plotOf(ownerName)
    local plots=workspace:FindFirstChild("Plots"); if not plots or not Sync then return nil,nil end
    for _,child in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(child.Name) end)
        if ok and type(t)=="table" and t.Owner then
            local nm=typeof(t.Owner)=="Instance" and t.Owner.Name or tostring(t.Owner)
            if nm==ownerName then return child.Name,t end
        end
    end
    return nil,nil
end

