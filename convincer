local function renderTraders()
    if not Sync then return end
    local plots=workspace:FindFirstChild("Plots"); if not plots then return end
    local byPlayer={}
    for _,child in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(child.Name) end)
        if ok and type(t)=="table" and type(t.AnimalList)=="table" then
            local owner=t.Owner; local name=typeof(owner)=="Instance" and owner.Name or tostring(owner)
            if name~=LP.Name and name~=LP.DisplayName then
                for _,item in ipairs(t.AnimalList) do
                    local def=Animals[item.Index]
                    if def and (tostring(def.Rarity)=="Secret" or tostring(def.Rarity)=="OG") then
                        local p=byPlayer[name]
                        if not p then p={player=name,playerObj=Players:FindFirstChild(name),items={},totalGen=0}; byPlayer[name]=p end
                        local g=genOf(item)
                        p.items[#p.items+1]={index=item.Index,mutation=item.Mutation~="None" and item.Mutation or nil,gen=g,rarity=tostring(def.Rarity)}
                        p.totalGen=p.totalGen+g
                    end
                end
            end
        end
    end
    local list={}; for _,p in pairs(byPlayer) do table.sort(p.items,function(a,b) return a.gen>b.gen end); list[#list+1]=p end
    table.sort(list,function(a,b) return a.totalGen>b.totalGen end)
    local q=searchQuery:lower():gsub("^%s+",""):gsub("%s+$","")
    local filtered=list
    if q~="" then
        filtered={}
        for _,p in ipairs(list) do
            local hit=p.player:lower():find(q,1,true)~=nil
            if not hit then for _,it in ipairs(p.items) do
                if it.index:lower():find(q,1,true) or (it.mutation and it.mutation:lower():find(q,1,true)) or it.rarity:lower():find(q,1,true) then hit=true; break end
            end end
            if hit then filtered[#filtered+1]=p end
        end
    end
    local sig=q.."~"..tostring(Settings.showAvatars).."~"
    for _,p in ipairs(filtered) do sig=sig..p.player..#p.items..math.floor(p.totalGen).."|" end
    if sig==LIST_LAST then return end; LIST_LAST=sig
    for _,ch in ipairs(listScroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    if #filtered==0 then
        local f=Instance.new("Frame",listScroll); f.Size=UDim2.new(1,0,0,80); f.BackgroundTransparency=1
        local t=Instance.new("TextLabel",f); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1
        t.Font=Enum.Font.GothamMedium; t.TextSize=12; t.TextColor3=THEME.OFF_TEXT; t.TextWrapped=true
        t.Text=q~="" and ('no matches for "'..q..'"') or "no Secret/OG traders found."
        return
    end
    for i,p in ipairs(filtered) do
        local card=Instance.new("Frame",listScroll); card.Size=UDim2.new(1,0,0,54); card.BackgroundTransparency=1
        card.LayoutOrder=i; card.ClipsDescendants=true; card.Name="P_"..i
        local inner=Instance.new("Frame",card); inner.Size=UDim2.new(1,-4,0,52); inner.Position=UDim2.fromOffset(2,1)
        inner.BackgroundColor3=THEME.SURF; inner.BorderSizePixel=0; corner(inner,10); stroke(inner,THEME.STROKE,1,0.6)
        local rank=Instance.new("TextLabel",inner); rank.Size=UDim2.fromOffset(20,54); rank.Position=UDim2.fromOffset(2,0)
        rank.BackgroundTransparency=1; rank.Font=Enum.Font.GothamBlack; rank.Text="# "..i; rank.TextSize=10; rank.TextColor3=THEME.ACCENT
        local offsetX=24
        if Settings.showAvatars then
            local av=Instance.new("ImageLabel",inner); av.Size=UDim2.fromOffset(34,34); av.Position=UDim2.fromOffset(24,9)
            av.BackgroundColor3=THEME.SURF2; av.BorderSizePixel=0; corner(av,17); av.ZIndex=3
            task.spawn(function()
                local uid=p.playerObj and p.playerObj.UserId
                if not uid then pcall(function() uid=Players:GetUserIdFromNameAsync(p.player) end) end
                if uid then local ok,img=pcall(function() return Players:GetUserThumbnailAsync(uid,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size48x48) end); if ok and img and av.Parent then av.Image=img end end
            end)
            offsetX=66
        end
        local nameL=Instance.new("TextLabel",inner); nameL.Size=UDim2.new(1,-(offsetX+118),0,18); nameL.Position=UDim2.fromOffset(offsetX,8)
        nameL.BackgroundTransparency=1; nameL.Font=Enum.Font.GothamBold; nameL.Text=p.player; nameL.TextSize=13
        nameL.TextColor3=THEME.TEXT; nameL.TextXAlignment=Enum.TextXAlignment.Left; nameL.TextTruncate=Enum.TextTruncate.AtEnd
        local sub=Instance.new("TextLabel",inner); sub.Size=UDim2.new(1,-(offsetX+118),0,14); sub.Position=UDim2.fromOffset(offsetX,28)
        sub.BackgroundTransparency=1; sub.Font=Enum.Font.GothamBold; sub.Text=#p.items.." • total $"..fmt(p.totalGen).."/s"
        sub.TextSize=10; sub.TextColor3=THEME.GREEN_STROKE; sub.TextXAlignment=Enum.TextXAlignment.Left

        local tradeBtn=button(inner,"TRADE",{textSize=10})
        tradeBtn.Size=UDim2.fromOffset(90,34); tradeBtn.Position=UDim2.new(1,-96,0.5,-17)
        local armed=false; local armTime=0; local busy=false
        local function resetTradeBtn() armed=false; busy=false; tradeBtn.Text="TRADE"; tween(tradeBtn,0.14,{BackgroundColor3=THEME.ACCENT2}) end
        tradeBtn.MouseButton1Click:Connect(function()
            if busy then return end
            if Settings.requireConfirmTrade and not (armed and (os.clock()-armTime)<4) then
                armed=true; armTime=os.clock(); tradeBtn.Text="CONFIRM"
                tween(tradeBtn,0.1,{BackgroundColor3=THEME.DANGER})
                task.delay(4.2,function() if tradeBtn.Parent and armed and (os.clock()-armTime)>=4 then resetTradeBtn() end end)
                return
            end
            busy=true; tradeBtn.Text="..."
            sendTradeRequest(p.player,function(status,detail)
                if not tradeBtn.Parent then return end
                if status=="sent" then tradeBtn.Text="SENT"; tradeBtn.BackgroundColor3=THEME.SUCCESS
                elseif status=="no_remote" then tradeBtn.Text="RETRY"; tradeBtn.BackgroundColor3=THEME.RETRY
                else tradeBtn.Text="FAILED"; tradeBtn.BackgroundColor3=THEME.FAIL end
                task.delay(2.2,function() if tradeBtn.Parent then resetTradeBtn() end end)
            end)
        end)
        local expandBtn=button(inner,"v",{color=THEME.SURF2,press=THEME.ACCENT2,stroke=THEME.STROKE,strokeT=0.5,textSize=13})
        expandBtn.Size=UDim2.fromOffset(32,34); expandBtn.Position=UDim2.new(1,-36,0.5,-17)
        local detail=Instance.new("Frame",card); detail.Size=UDim2.new(1,0,0,0); detail.Position=UDim2.fromOffset(0,54)
        detail.BackgroundTransparency=1; detail.BorderSizePixel=0; detail.ClipsDescendants=true
        local dl=Instance.new("UIListLayout",detail); dl.Padding=UDim.new(0,6); dl.SortOrder=Enum.SortOrder.LayoutOrder
        local dp=Instance.new("UIPadding",detail); dp.PaddingTop=UDim.new(0,6); dp.PaddingLeft=UDim.new(0,16); dp.PaddingRight=UDim.new(0,4); dp.PaddingBottom=UDim.new(0,6)
        for j,it in ipairs(p.items) do
            local row=Instance.new("Frame",detail); row.Size=UDim2.new(1,0,0,42); row.LayoutOrder=j
            row.BackgroundColor3=THEME.SURF2; row.BorderSizePixel=0; corner(row,8); stroke(row,THEME.STROKE,1,0.7)
            local nm=Instance.new("TextLabel",row); nm.Size=UDim2.new(1,-14,0,18); nm.Position=UDim2.fromOffset(10,4)
            nm.BackgroundTransparency=1; nm.Font=Enum.Font.GothamBold; nm.RichText=true
            local mut=it.mutation
            if mut then
                local def=Mutations[mut]; local col=def and def.MainColor and tostring(def.MainColor) or nil; local hex="B0B0B0"
                if col then local nums={}; for m in col:gmatch("[%d%.]+") do nums[#nums+1]=tonumber(m) end; if #nums>=3 then hex=Color3.new(nums[1],nums[2],nums[3]):ToHex() end end
                mut=('  <font color="#%s">%s</font>'):format(hex,mut)
            end
            nm.Text=it.index..(mut or ""); nm.TextSize=12; nm.TextColor3=THEME.TEXT; nm.TextXAlignment=Enum.TextXAlignment.Left; nm.TextTruncate=Enum.TextTruncate.AtEnd
            local sub2=Instance.new("TextLabel",row); sub2.Size=UDim2.new(1,-14,0,14); sub2.Position=UDim2.fromOffset(10,22)
            sub2.BackgroundTransparency=1; sub2.Font=Enum.Font.GothamBold; sub2.Text="$"..fmt(it.gen).."/s  •  "..it.rarity
            sub2.TextSize=10; sub2.TextColor3=THEME.GREEN_STROKE; sub2.TextXAlignment=Enum.TextXAlignment.Left
        end
        local expanded=false; local totalH=#p.items*48+6+32
        local function setExpand(on)
            expanded=on; expandBtn.Text=on and "^" or "v"
            local h=on and totalH or 0
            tween(detail,0.22,{Size=UDim2.new(1,0,0,h)}); tween(card,0.22,{Size=UDim2.new(1,0,0,54+h)})
        end
        expandBtn.MouseButton1Click:Connect(function() setExpand(not expanded) end)
        inner.MouseEnter:Connect(function() tween(inner,0.12,{BackgroundColor3=THEME.SURF2}) end)
        inner.MouseLeave:Connect(function() tween(inner,0.12,{BackgroundColor3=THEME.SURF}) end)
    end
end
