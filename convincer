local function decodeTranslationResponse(r)
    if type(r)~="table" then return nil end
    if r.Success==false or r.success==false then return nil end
    local st=r.StatusCode or r.status_code or r.Status or r.status
    if st~=nil then st=tonumber(st); if not st or st<200 or st>=300 then return nil end end
    local b=r.Body or r.body; if type(b)~="string" or b=="" then return nil end
    local ok,d=pcall(function() return HS:JSONDecode(b) end)
    return ok and type(d)=="table" and d or nil
end
local function googleTranslate(text,tl,sl)
    sl=type(sl)=="string" and sl~="" and sl or "auto"
    if type(text)~="string" or text=="" or type(tl)~="string" or tl=="" or type(HTTP)~="function" then return text,sl end
    local ok,res=pcall(function()
        local url=("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(HS:UrlEncode(sl),HS:UrlEncode(tl),HS:UrlEncode(text))
        return HTTP({Url=url,Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    end)
    if not ok then return text,sl end
    local d=decodeTranslationResponse(res); local f=d and d[1]
    if type(f)=="table" then if type(f[1])=="string" and f[1]~="" then local det=type(f[2])=="string" and f[2]~="" and f[2] or sl; return f[1],det end
    elseif type(f)=="string" and f~="" then return f,sl end
    return text,sl
end
