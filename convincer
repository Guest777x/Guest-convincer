        local idx=1; for i,v in ipairs(list) do if v==state.selected then idx=i; break end end
        local frac=#list<=1 and 0.84 or (idx==1 and 0.16 or idx==2 and 0.5 or 0.84)
        railKnob.Size=UDim2.new(1,0,frac,0)
    end
    BaseMeta.toggle=function(owner)
        if BasePanel.Visible and state.plotInst then
            local plotName=plotOf(owner)
