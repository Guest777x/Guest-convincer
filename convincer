local function corner(parent, r)
    local c = Instance.new("UICorner", parent); c.CornerRadius = UDim.new(0, r or 8); return c
end
local function stroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke", parent)
    s.Color = color or THEME.STROKE; s.Thickness = thick or 1; s.Transparency = trans or 0.4; return s
end
local function tween(obj, dur, props)
    TweenService:Create(obj, TweenInfo.new(dur or 0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end
local function shadow(parent)
    local i = Instance.new("ImageLabel", parent)
    i.AnchorPoint = Vector2.new(0.5, 0.5); i.Position = UDim2.new(0.5,0,0.5,2)
    i.Size = UDim2.new(1,26,1,26); i.BackgroundTransparency = 1
    i.Image = "rbxassetid://6014261993"; i.ImageColor3 = Color3.new(0,0,0)
    i.ImageTransparency = 0.72; i.ScaleType = Enum.ScaleType.Slice
    i.SliceCenter = Rect.new(49,49,450,450); i.ZIndex = 0; return i
end
local function button(parent, text, opts)
    opts = opts or {}
    local b = Instance.new("TextButton", parent)
    b.AutoButtonColor = false
    b.BackgroundColor3 = opts.color or THEME.ACCENT2
    b.BorderSizePixel = 0
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = opts.textSize or 11
    b.TextColor3 = THEME.TEXT
    corner(b, opts.radius or 8)
    local s = stroke(b, opts.stroke or THEME.ACCENT, 1, opts.strokeT or 0.35)
    b.MouseButton1Down:Connect(function() tween(b, 0.08, { BackgroundColor3 = opts.press or THEME.ACCENT }) end)
    b.MouseButton1Up:Connect(function() tween(b, 0.14, { BackgroundColor3 = opts.color or THEME.ACCENT2 }) end)
    return b, s
end

