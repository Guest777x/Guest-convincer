-- ============================================================
local function resolvePlaceId(tier)
    if not Data.ServerData then return game.PlaceId end
    if tier == "Pro" then return Data.ServerData.TradePlazaProPlaceId end
    if tier == "OG" then return Data.ServerData.TradePlazaOgPlaceId end
    return Data.ServerData.TradePlazaPlaceId
end

local function listServers()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    pg = pg and pg:FindFirstChild("TradePlazaServerBrowser")
    pg = pg and pg:FindFirstChild("List", true)
    local list = {}
    if not pg then return list end
    for _, child in ipairs(pg:GetChildren()) do
        if child:IsA("GuiObject") and #child.Name >= 30 then
            local expired = false
            local seen = Hops.hoppedServers[child.Name]
            if seen then expired = os.time() - seen < 600 end
            if child.Name ~= tostring(game.JobId) and not expired then
                local text = child:FindFirstChild("Bottom") and child.Bottom:FindFirstChild("Players") and child.Bottom.Players.Text
                local players = text and tonumber(text:match("(%d+)")) or 0
                local max = text and tonumber(text:match("/(%d+)")) or 28
                list[#list+1] = { jobId = child.Name, players = players, maxPlayers = max }
            end
        end
    end
    return list
end

local Toast  -- forward

local function hopServer(tier)
    tier = tier or Settings.hopTier or "Normal"
    local placeId = resolvePlaceId(tier)
    if not placeId or placeId == 0 then Toast("HOP FAILED", tier .. " tier unavailable"); return false end
    pcall(function() Hops.hoppedServers[tostring(game.JobId)] = os.time() end)
    saveHops()
    local svc = game:GetService("TeleportService")
    local servers = listServers()
    if #servers > 0 then
        table.sort(servers, function(a,b) return a.players < b.players end)
        for _, s in ipairs(servers) do
            if s.players < s.maxPlayers then
                Toast("HOPPING", "joining a new server...", 3)
                if pcall(function() svc:TeleportToPlaceInstance(placeId, s.jobId, LocalPlayer) end) then return true end
                Hops.hoppedServers[s.jobId] = os.time()
            end
        end
        saveHops()
    end
    Toast("HOPPING", "joining a new " .. tier .. " server...", 3)
    local ok, err = pcall(function() svc:Teleport(placeId, LocalPlayer) end)
    if not ok then Toast("HOP FAILED", tostring(err):sub(1,60)); return false end
    return true
end

