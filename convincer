local function findSendTradePrompt(ownerName)
    local plotName=plotOf(ownerName); if not plotName then return nil end
    local plot=workspace.Plots:FindFirstChild(plotName); if not plot then return nil end
    for _,d in ipairs(plot:GetDescendants()) do if d:IsA("ProximityPrompt") and d.ActionText=="SEND TRADE" then return d end end
    return nil
end
local function stripRich(s) return (tostring(s):gsub("<[^>]+>","")) end
local function watchNotification(timeout,cb)
    local pg=LP:FindFirstChild("PlayerGui"); local notifGui=pg and pg:FindFirstChild("Notification")
    local notif=notifGui and notifGui:FindFirstChild("Notification"); if not notif then cb(nil); return end
    local fired=false; local conn
    local function handle(child)
        if fired then return end
        if child:IsA("TextLabel") then
            local txt=child.Text; if type(txt)~="string" then return end
            local clean=stripRich(txt)
            if #clean>1 and clean~="NOTIFICATION TEMPLATE" then fired=true; if conn then conn:Disconnect() end; cb(clean) end
        end
    end
    conn=notif.ChildAdded:Connect(function(c) task.wait(0.05); handle(c) end)
    task.delay(timeout,function() if not fired then fired=true; if conn then conn:Disconnect() end; cb(nil) end end)
end
local function sendTradeRequest(ownerName,cb)
    cb=cb or function() end
    if type(fireproximityprompt)~="function" then cb("no_remote","executor missing fireproximityprompt"); return end
    local prompt=findSendTradePrompt(ownerName); if not prompt then cb("error","not in server"); return end
    if not prompt.Enabled then cb("error","unavailable"); return end
    if not pcall(function() fireproximityprompt(prompt) end) then cb("error","failed"); return end
    local done=false
    watchNotification(1.5,function(text)
        if done then return end; done=true
        if not text then cb("sent",nil); return end
        local l=text:lower()
        if l:find("request sent") or l:find("sent to") or l:find("trade request") then cb("sent",nil)
        else cb("error",text) end
    end)
end

-- ========== HOP ==========
local function resolvePlaceId(tier)
    if not ServerData then return game.PlaceId end
    if tier=="Pro" then return ServerData.TradePlazaProPlaceId end
    if tier=="OG" then return ServerData.TradePlazaOgPlaceId end
    return ServerData.TradePlazaPlaceId
end
local function listServers()
    local pg=LP:FindFirstChild("PlayerGui"); pg=pg and pg:FindFirstChild("TradePlazaServerBrowser"); pg=pg and pg:FindFirstChild("List",true)
    local list={}; if not pg then return list end
    for _,child in ipairs(pg:GetChildren()) do
        if child:IsA("GuiObject") and #child.Name>=30 then
            local expired=false; local seen=Hops.hoppedServers[child.Name]; if seen then expired=os.time()-seen<600 end
            if child.Name~=tostring(game.JobId) and not expired then
                local text=child:FindFirstChild("Bottom") and child.Bottom:FindFirstChild("Players") and child.Bottom.Players.Text
                local pl=text and tonumber(text:match("(%d+)")) or 0
                local mx=text and tonumber(text:match("/(%d+)")) or 28
                list[#list+1]={jobId=child.Name,players=pl,maxPlayers=mx}
            end
        end
    end
    return list
end
local Toast
local function hopServer(tier)
    tier=tier or Settings.hopTier or "Normal"
    local placeId=resolvePlaceId(tier)
    if not placeId or placeId==0 then Toast("HOP FAILED",tier.." tier unavailable"); return false end
    pcall(function() Hops.hoppedServers[tostring(game.JobId)]=os.time() end); saveHops()
    local svc=game:GetService("TeleportService"); local servers=listServers()
    if #servers>0 then
        table.sort(servers,function(a,b) return a.players<b.players end)
        for _,s in ipairs(servers) do
            if s.players<s.maxPlayers then
                Toast("HOPPING","joining a new server...",3)
                if pcall(function() svc:TeleportToPlaceInstance(placeId,s.jobId,LP) end) then return true end
                Hops.hoppedServers[s.jobId]=os.time()
            end
        end
        saveHops()
    end
    Toast("HOPPING","joining a new "..tier.." server...",3)
    local ok,err=pcall(function() svc:Teleport(placeId,LP) end)
    if not ok then Toast("HOP FAILED",tostring(err):sub(1,60)); return false end
    return true
end

