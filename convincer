-- Incoming chat reader (read-only). Filters Message* frames in trade chat.
local seenCount = 0
local function messageFrames(sf)
    local arr = {}
    for _, ch in ipairs(sf:GetChildren()) do
        if ch:IsA("Frame") and ch.Name:find("^Message") then arr[#arr+1] = ch end
    end
    table.sort(arr, function(a,b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
    local out = {}
    for _, f in ipairs(arr) do
        local label = f:FindFirstChild("Label", true)
        local txt = label and label.Text
        if type(txt) == "string" and #txt >= 2 and txt ~= "Template" then
            local theirs = true
            local pi = f:FindFirstChild("PlayerImage")
            pi = pi and pi:FindFirstChild("Headshot")
            if pi and type(pi.Image) == "string" then
                local m = pi.Image:match("id=(%d+)")
                if m and tonumber(m) == LocalPlayer.UserId then theirs = false end
            end
            out[#out+1] = { text = txt, theirs = theirs }
        end
    end
    return out
end

local function attachChat(sf)
    local function sync()
        local msgs = messageFrames(sf)
        if #msgs < seenCount then seenCount = 0 end
        for i = seenCount + 1, #msgs do
            local m = msgs[i]
            if m.theirs and Settings.translatorOn and alive() then
                task.spawn(function()
                    local words = 0
                    for _ in tostring(m.text):gmatch("%S+") do words = words + 1 end
                    local translated, detected = googleTranslate(m.text, Settings.myLang, "auto")
                    voteLanguage(detected, math.clamp(words, 1, 8))
                    pushLog(m.text, (translated and translated ~= m.text) and translated or m.text)
                end)
            end
        end
        seenCount = #msgs
    end
    sync()
    sf.ChildAdded:Connect(function() task.defer(sync) end)
    sf.ChildRemoved:Connect(function() task.defer(sync) end)
end

local function attachTradeUI(tlu)
    task.spawn(function()
        local chat = tlu:WaitForChild("Chat", 5)
        if not chat then return end
        for _, n in ipairs({"NormalChat","RestrictedChat"}) do
            local c = chat:FindFirstChild(n)
            local sf = c and c:FindFirstChild("ScrollingFrame")
            if sf then attachChat(sf) end
        end
    end)
end

task.spawn(function()
    local pg = LocalPlayer:WaitForChild("PlayerGui", 30)
    if not pg then return end
    local tlu = pg:FindFirstChild("TradeLiveTrade")
    if tlu then attachTradeUI(tlu) end
    pg.ChildAdded:Connect(function(c) if c.Name == "TradeLiveTrade" then attachTradeUI(c) end end)
end)

