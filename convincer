local function findPriority()
    if not Settings.priorityList or #Settings.priorityList==0 then return nil end
    local set={}; for _,v in ipairs(Settings.priorityList) do set[tostring(v):lower()]=true end
    local plots=workspace:FindFirstChild("Plots"); if not plots or not Sync then return nil end
    for _,child in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(child.Name) end)
        if ok and type(t)=="table" and type(t.AnimalList)=="table" then
            for _,item in ipairs(t.AnimalList) do
                if type(item)=="table" and item.Index and item.Index~="Empty" and set[tostring(item.Index):lower()] then
                    local owner=typeof(t.Owner)=="Instance" and t.Owner.Name or tostring(t.Owner)
                    return owner,item.Index
                end
            end
        end
    end
    return nil
end
