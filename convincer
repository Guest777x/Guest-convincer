local function sendTradeChat(text)
    if not text or text == "" then return false end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local tl = pg:FindFirstChild("TradeLiveTrade")
    tl = tl and tl:FindFirstChild("TradeLiveTrade")
    tl = tl and tl:FindFirstChild("Chat")
    local box
    for _, k in ipairs({"NormalChat","RestrictedChat"}) do
        local c = tl and tl:FindFirstChild(k)
        c = c and c:FindFirstChild("ChatBox")
        c = c and c:FindFirstChildWhichIsA("TextBox")
        if c then box = c break end
    end
    if not box then return false end
    return (pcall(function()
        box.Text = text
        if type(firesignal) == "function" then
            firesignal(box.FocusLost, true, Enum.KeyCode.Return)
        else
            box:CaptureFocus()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        end
    end))
end

-- ============================================================
-- SAFE TRADE OPEN (explicit user click, then game's own prompt)
-- This ONLY fires the game's own SEND TRADE prompt for the target. It does NOT
-- accept anything, does NOT auto-confirm, does NOT bypass the trade UI. The user
-- must still complete the trade in-game with full visibility.
-- ============================================================
local function findSendTradePrompt(ownerName)
    local plotName = plotOf(ownerName)
    if not plotName then return nil end
    local plot = workspace.Plots:FindFirstChild(plotName)
    if not plot then return nil end
    for _, d in ipairs(plot:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.ActionText == "SEND TRADE" then return d end
    end
    return nil
end

local function openTradeUIFor(ownerName)
    if type(fireproximityprompt) ~= "function" then return false, "executor missing fireproximityprompt" end
    local p = findSendTradePrompt(ownerName)
    if not p or not p.Enabled then return false, "trade prompt unavailable" end
    local ok = pcall(function() fireproximityprompt(p) end)
    if not ok then return false, "prompt fire failed" end
    return true
end

