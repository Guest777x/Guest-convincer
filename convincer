-- BEAM TO BASE (explicit, non-trade)
-- ============================================================
local Beam = { owner = nil, hl = nil, beam = nil, att0 = nil, att1 = nil, conn = nil }
local function clearBeam()
    if Beam.conn then Beam.conn:Disconnect(); Beam.conn = nil end
    for _, k in ipairs({"hl","beam","att0","att1"}) do
        if Beam[k] then pcall(function() Beam[k]:Destroy() end); Beam[k] = nil end
    end
    Beam.owner = nil
end
local function beamTo(owner)
    if not Settings.beamToBase then Toast("BEAM", "enable Beam to base in settings"); return false end
    if Beam.owner == owner then clearBeam(); return false end
    clearBeam()
    local plotName = plotOf(owner)
    local plots = workspace:FindFirstChild("Plots")
    local plot = plots and plotName and plots:FindFirstChild(plotName)
    if not plot then Toast("BEAM", "base not in this server"); return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    pcall(function() if setthreadidentity then setthreadidentity(8) end end)
    Beam.owner = owner
    local hl = Instance.new("Highlight")
    hl.FillColor = THEME.ACCENT; hl.FillTransparency = 0.85
    hl.OutlineColor = THEME.ACCENT; hl.OutlineTransparency = 0.15
    hl.Adornee = plot; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = plot; Beam.hl = hl
    local sp = plot:FindFirstChild("Spawn") or plot:FindFirstChildWhichIsA("BasePart", true)
    if sp then
        local a0 = Instance.new("Attachment"); a0.Parent = sp
        a0.WorldPosition = sp.Position + Vector3.new(0,4,0)
        local a1 = Instance.new("Attachment"); a1.Parent = hrp
        local b = Instance.new("Beam")
        b.Attachment0 = a0; b.Attachment1 = a1
        b.Color = ColorSequence.new(THEME.ACCENT)
        b.Width0 = 1.4; b.Width1 = 0.7; b.FaceCamera = true
        b.LightEmission = 1; b.Transparency = NumberSequence.new(0.15)
        b.Parent = a0
        Beam.att0 = a0; Beam.att1 = a1; Beam.beam = b
    end
    Beam.conn = plot.AncestryChanged:Connect(function()
        if not plot:IsDescendantOf(workspace) then clearBeam() end
    end)
    Toast("BEAM", "tracking " .. owner .. "'s base", 2)
    return true
end

