local function voteLanguage(code, weight)
    if not code or code == "auto" or code == "" then return end
    langVotes[code] = (langVotes[code] or 0) + weight
    local best, bestN = nil, 0
    for k, v in pairs(langVotes) do
        if k ~= "en" and v > bestN then best, bestN = k, v end
    end
    if not best then
        for k, v in pairs(langVotes) do if v > bestN then best, bestN = k, v end end
    end
    if best and Settings.theirLang ~= best then
        Settings.theirLang = best; theirVal.Text = langName(best); saveCfg()
    end
end

